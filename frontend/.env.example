# DORAnsible frontend environment örneği.
# Kullanım: cp .env.example .env.local
#
# Vite yalnızca VITE_ ön ekli değişkenleri bundle'a dahil eder.
# Bu dosyaya API key veya başka bir secret YAZILMAZ; frontend bundle'ı
# herkese açıktır (GUVENLIK.md bölüm 3).

# Backend API kök adresi.
VITE_API_BASE_URL=http://127.0.0.1:8000
