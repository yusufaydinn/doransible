# DORAnsible backend environment örneği.
# Bu dosya GERÇEK DEĞER İÇERMEZ (GUVENLIK.md bölüm 3).
# Kullanım: cp .env.example .env

# Uygulama görünen adı
ANSIBLEOPS_APP_NAME=DORAnsible

# development | production
ANSIBLEOPS_ENVIRONMENT=development

# Veritabanı, job artifact'leri ve staging alanının kökü.
# Varsayılan: repository kökündeki app-data dizini.
# ANSIBLEOPS_APP_DATA_DIR=/srv/ansibleops/app-data

# Boş bırakılırsa app-data/database/app.db üzerinde SQLite kullanılır.
# PostgreSQL örneği (parola buraya yazılmaz, deployment secret'ından gelir):
# ANSIBLEOPS_DATABASE_URL=postgresql+psycopg://ansibleops@localhost/ansibleops

# Frontend origin allowlist. JSON dizisi olarak verilir.
ANSIBLEOPS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Project kaydı yapılabilecek dizin kökleri (GUVENLIK.md bölüm 4).
# JSON dizisi, absolute path. Boş bırakılırsa yalnızca app-data/projects kabul edilir.
# Bu listenin dışındaki her path 403 path_not_allowed ile reddedilir.
# ANSIBLEOPS_PROJECT_ROOT_ALLOWLIST=["/srv/ansible/projeler"]

# Standalone (project'e bağlı olmayan) inventory dosyalarının kökleri (ADR-015).
# JSON dizisi, absolute path. Boş bırakılırsa yalnızca app-data/inventories
# kabul edilir; bu dizini uygulama kendisi oluşturur.
# Project allowlist'inden bilinçli olarak AYRIDIR: project kökü altındaki her
# dosya kendiliğinden kaydedilebilir bir inventory sayılmaz.
# Project'e bağlı inventory bu listeye değil, project'in kendi köküne tabidir.
# ANSIBLEOPS_INVENTORY_ROOT_ALLOWLIST=["/srv/ansible/envanterler"]

# T-202 inventory parser. Komut ARGÜMAN LİSTESİ olarak verilir; shell kullanılmaz.
# Ayrı bir venv'deki veya sistem genelindeki ansible-inventory gösterilebilir.
# ANSIBLEOPS_ANSIBLE_INVENTORY_COMMAND=["/opt/ansible/bin/ansible-inventory"]
# ANSIBLEOPS_INVENTORY_PARSE_TIMEOUT_SECONDS=30
# ANSIBLEOPS_INVENTORY_PARSE_MAX_OUTPUT_BYTES=5000000

# Ping preview YALNIZCA onay planı üretir; hiçbir SSH bağlantısı kurmaz ve
# ansible ad-hoc ping çalıştırmaz. Gerçek bağlantı, tek kullanımlık token'ın
# confirm endpoint'inde claim edilmesiyle başlar.
#
# Onay planının geçerlilik süresi (saniye, 0 < x <= 3600).
# ANSIBLEOPS_PING_PREVIEW_TTL_SECONDS=300
#
# Claim edilmiş bir preview state'inin terk edilmiş sayılması için gereken süre.
# Normal TTL'den AYRIDIR: aksi hâlde başka bir isteğin süpürücüsü, o an çalışan
# bir execution'ın dondurulmuş snapshot'ını silebilirdi.
# Alt sınır, mevcut 300 saniyelik güvenlik tabanı ile ping timeout + 5 saniye
# terminate grace + 30 saniye güvenlik payının büyük olanıdır. Daha düşük
# değer clamp edilmez; uygulama AÇILIŞTA HATA VERİR.
# ANSIBLEOPS_PING_PREVIEW_CLAIM_STALE_SECONDS=300
#
# Planda listelenecek azami host adı. host_count bu sınırdan bağımsız olarak
# her zaman kesindir.
# ANSIBLEOPS_PING_PREVIEW_MAX_LISTED_HOSTS=500
#
# Bir işlemi kimin istediği. MVP 1 tek kullanıcılıdır ve gerçek authentication
# YOKTUR; bu yüzden değer yapılandırmadan gelen sabit bir etikettir. Uygulama
# OS kullanıcı adı veya istemci IP'si ÜRETMEZ: ikisi de doğrulanmamış bir
# kimliğe doğrulanmış görünümü verirdi. Preview meta'sına yazılır ve onay
# anında yeniden karşılaştırılır. En fazla 100 karakter.
# ANSIBLEOPS_LOCAL_ACTOR=local-single-user

# Inventory'de gösterilebilecek SSH private key dosyalarının kökleri.
# Bu değer controller üzerinde dosya OKUTUR; bu yüzden project ve inventory
# allowlist'lerinden ayrıdır. Boş bırakılırsa yalnızca app-data/secrets kabul
# edilir. İzin verilen kök altında bulunmayan bir anahtar 422 ping_inventory_unsafe
# ile reddedilir.
# ANSIBLEOPS_SSH_KEY_ROOT_ALLOWLIST=["/srv/ansibleops/secrets"]

# SSH host key politikası: strict | accept_new
# strict  : bilinmeyen host key'i reddedilir (varsayılan).
# accept_new: TOFU. İlk bağlantı doğrulanmaz ve MITM'e açıktır; sonraki anahtar
#           değişiklikleri reddedilir. Bilinçli olarak seçilmelidir.
# Host key doğrulamasını KAPATAN bir değer yoktur.
# ANSIBLEOPS_SSH_HOST_KEY_POLICY=strict

# Güvenli ping execution sınırları. Komut argv listesidir; shell yoktur.
# Stale alt sınırı: ping timeout + 5 saniye termination grace + 30 saniye pay.
# Ping timeout, Job stale, preview TTL ve claim-stale NaN/Infinity olamaz.
# ANSIBLEOPS_ANSIBLE_AD_HOC_COMMAND=["/opt/ansible/bin/ansible"]
# ANSIBLEOPS_PING_TIMEOUT_SECONDS=30
# ANSIBLEOPS_PING_MAX_OUTPUT_BYTES=5000000
# ANSIBLEOPS_SSH_CONNECT_TIMEOUT_SECONDS=10
# ANSIBLEOPS_PING_FORKS=10
# ANSIBLEOPS_SSH_KNOWN_HOSTS_PATH=/srv/ansibleops/app-data/ssh/known_hosts
# ANSIBLEOPS_JOB_STALE_SECONDS=300

# Playbook keşif sınırları. Aşıldığında hata değil, cevapta truncated=true üretir.
# ANSIBLEOPS_PLAYBOOK_SCAN_MAX_DEPTH=12
# ANSIBLEOPS_PLAYBOOK_SCAN_MAX_ENTRIES=20000
# ANSIBLEOPS_PLAYBOOK_SCAN_MAX_RESULTS=500
# ANSIBLEOPS_PLAYBOOK_SCAN_READ_BYTES=65536

# Hazırlanmış execution planı sınırları.
# ANSIBLEOPS_EXECUTION_PLAN_TTL_SECONDS=600
# ANSIBLEOPS_EXECUTION_PLAN_STAGING_STALE_SECONDS=900

# Playbook runner komutu ve bounded çıktı/artifact sınırları. Komut JSON argv
# listesidir; shell kullanılmaz.
# ANSIBLEOPS_ANSIBLE_RUNNER_COMMAND=["/opt/ansible/bin/ansible-runner"]
# ANSIBLEOPS_PLAYBOOK_RUNNER_TIMEOUT_SECONDS=1800
# ANSIBLEOPS_PLAYBOOK_RUNNER_MAX_STDOUT_BYTES=5000000
# ANSIBLEOPS_PLAYBOOK_RUNNER_MAX_RAW_BYTES=50000000
# ANSIBLEOPS_PLAYBOOK_RUNNER_MAX_EVENTS=20000
# ANSIBLEOPS_PLAYBOOK_RUNNER_MAX_RESULT_BYTES=1000000

# Worker sahipliği, polling ve crash-run temizliği.
# ANSIBLEOPS_PLAYBOOK_WORKER_LEASE_SECONDS=120
# ANSIBLEOPS_PLAYBOOK_WORKER_HEARTBEAT_SECONDS=30
# ANSIBLEOPS_PLAYBOOK_WORKER_POLL_SECONDS=1
# ANSIBLEOPS_EXECUTION_RUN_STALE_SECONDS=2700
# ANSIBLEOPS_EXECUTION_RUN_JANITOR_INTERVAL_SECONDS=600

# Launch endpoint'i yalnız pending Job oluşturur; runner'ı route içinde
# başlatmaz. Job'ın işlenmesi için arka plan worker'ı açık olmalıdır.
# Varsayılan false'tur. Check VE Normal Job'ları çalıştırmak istediğiniz
# kontrollü tek-operatör kurulumunda açıkça true yapın:
# ANSIBLEOPS_PLAYBOOK_WORKER_ENABLED=true
#
# Bu ayar sandbox sağlamaz. Worker, kayıtlı ve onaylanmış playbook'u seçilen
# kipte gerçek hedeflerde çalıştırabilir. Güvenmediğiniz içerikleri kaydetmeyin.
